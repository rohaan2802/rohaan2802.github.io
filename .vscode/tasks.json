{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start-dev-server",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "portfolio-dev",
        "pattern": {
          "regexp": "^SERVER_READY:(https?://\\S+)$",
          "line": 1,
          "uri": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Starting portfolio",
          "endsPattern": "^SERVER_READY:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      }
    }
  ]
}
